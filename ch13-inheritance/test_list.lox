class Stack {
  init() { this.items = List(); }
  push(x) { this.items.add(x); }
  pop() { return this.items.remove(this.items.length - 1); }
  size { return this.items.length; }
}
var s = Stack();
s.push("a");
s.push("b");
print s.pop();
print s.size;

fun makeList(n) {
  var l = List();
  for (var i = 0; i < n; i = i + 1) l.add(i * i);
  return l;
}
print makeList(5);
